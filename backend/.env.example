# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsflow_biopass?schema=public"

# App & Server
PORT=4000
NODE_ENV=development
BASE_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:5173"
PUBLIC_EMERGENCY_BASE_URL="http://localhost:5173/e"

# JWT Secret
JWT_SECRET="biopass_cortex_super_secure_jwt_secret_2026_key"
JWT_EXPIRES_IN="7d"

# OTP (login via WhatsApp Baileys)
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_DEV_ECHO=true          # if true AND NODE_ENV=development, the OTP is returned in the API response / logged

# Web Push (VAPID) - run: npx web-push generate-vapid-keys  and paste below
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:soporte@bio-pass.com"

# Payment webhook shared secret (gateway must send it as the X-Webhook-Secret header)
PAYMENT_WEBHOOK_SECRET="change_me"

# WhatsApp reconnect tuning (max automatic reconnect attempts before giving up)
WHATSAPP_MAX_RECONNECT=8

# Twilio Configuration (Voice & SMS fallback)
TWILIO_ACCOUNT_SID="AC_mock_twilio_account_sid_doorway_cortex"
TWILIO_AUTH_TOKEN="mock_twilio_auth_token"
TWILIO_PHONE_NUMBER="+15551234567"

# Baileys WhatsApp Session Path
BAILEYS_AUTH_DIR="./auth_info_baileys"
WHATSAPP_BOT_NUMBER="595981000000"

# AI / OCR Configuration (OpenAI GPT-4-Vision or Google Gemini / Tesseract)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# S3 / MinIO Storage Configuration
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="biopass-medical-vault"
S3_REGION="us-east-1"
USE_LOCAL_STORAGE=true
UPLOAD_DIR="./uploads"

# Payment Gateways (Paraguay & Brasil)
PARAGUAY_BANK_ALIAS="BIOPASS.PY"
PARAGUAY_BANK_NAME="Banco Continental / Bancard"
PARAGUAY_TIGO_MONEY_WALLET="0981123456"
BRASIL_PIX_KEY="financeiro@bio-pass.com"
MERCADOPAGO_ACCESS_TOKEN="TEST-mock-token-mercadopago"

# ---- OCR / AI vision / Email / Payments ----
CORS_ORIGINS="http://localhost:5173"     # comma-separated allowlist; '*' = permissive

OCR_ENABLED=true
OCR_LANGS="spa+eng"

AI_VISION_PROVIDER=""                      # openai | gemini | none (blank = auto)
OPENAI_VISION_MODEL="gpt-4o-mini"
GEMINI_VISION_MODEL="gemini-1.5-flash"

SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Doorway Cortex Bio-Pass <no-reply@bio-pass.com>"

BANCARD_PUBLIC_KEY=""
BANCARD_PRIVATE_KEY=""
BANCARD_ENV="staging"

TIGO_MONEY_API_URL=""
TIGO_MONEY_CLIENT_ID=""
TIGO_MONEY_CLIENT_SECRET=""

PIX_PSP="manual"                          # manual | mercadopago
PIX_MERCHANT_NAME="DOORWAY CORTEX BIOPASS"
PIX_MERCHANT_CITY="SAO PAULO"
